<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <android.support.v7.widget.CardView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="2dp"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        card_view:cardCornerRadius="5dp"
        card_view:contentPadding="2dp">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardView_comments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="9"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="7dp">
                <de.hdodenhof.circleimageview.CircleImageView
                    xmlns:app="http://schemas.android.com/tools"
                    android:id="@+id/profile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:civ_border_color="@color/grey_50"
                    app:civ_border_width="@dimen/DrawerHeader_CircleImageView_border_width"
                    android:src="@android:drawable/ic_menu_gallery"/>
                <TextView
                    android:id="@+id/insidecomment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:singleLine="true"
                    android:gravity="left|center"
                    android:lines="@android:integer/config_longAnimTime"
                    android:text="comments"
                    android:textColor="#000" />

                <TextView
                    android:id="@+id/user_roles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="3dp"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="roles"
                    android:textSize="13dp" />

                <ImageButton
                    android:id="@+id/playVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:src="@drawable/video_view"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/image"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:src="@drawable/image"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/deleteTask"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/Button_menu"
                    android:layout_width="40dp"
                    android:layout_height="45dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_feed_action"
                    android:src="@drawable/ic_more_grey_48" />

            </LinearLayout>
        </LinearLayout>
    </android.support.v7.widget.CardView>


</LinearLayout>
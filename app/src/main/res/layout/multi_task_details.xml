<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/getTaskHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="taskHeading"
        android:textColor="#000000"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/getTaskDes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="taskHeading"
        android:textStyle="normal"/>
    <TextView
        android:id="@+id/getSelectUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="taskHeading"
        android:textStyle="normal"/>
    <TextView
        android:id="@+id/getStartToTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="taskHeading"
        android:textStyle="normal"/>
    <TextView
        android:id="@+id/getStartFromTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="taskHeading"
        android:textStyle="normal"/>
    <TextView
        android:id="@+id/getActEndDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="taskHeading"
        android:textStyle="normal"/>
    <TextView
        android:id="@+id/getActStartDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="taskHeading"
        android:textStyle="normal"/>




</LinearLayout>
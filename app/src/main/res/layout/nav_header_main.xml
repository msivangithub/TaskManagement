<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/header_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pink_900"
    android:gravity="left"
    android:orientation="vertical"
    android:padding="@dimen/DrawerHeader_paddin"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <de.hdodenhof.circleimageview.CircleImageView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/imageView"
        android:layout_width="@dimen/DrawerHeader_CircleImageView_width"
        android:layout_height="@dimen/DrawerHeader_CircleImageView_height"
        android:layout_marginTop="@dimen/DrawerHeader_CircleImageView_marginTop"
        android:src="@drawable/profile_sample"
        app:civ_border_color="@color/white"
        app:civ_border_width="@dimen/DrawerHeader_CircleImageView_border_width" />

    <TextView
        android:id="@+id/txt_UserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:text="aaaaaa"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_Mail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/profile_image"
        android:gravity="left"
        android:text="aaaaaaa"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="@color/white"
        android:textStyle="normal" />


</LinearLayout>


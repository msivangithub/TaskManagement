<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#fff"
    android:padding="@dimen/taskCreation_padding">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:gravity="center"
                android:text="Task Heading"
                android:textColor="#000"
                android:textSize="@dimen/taskCreation_textSize"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/taskHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:background="@drawable/rounded_edittext"
                android:gravity="bottom"
                android:hint="Select type of task?"
                android:padding="@dimen/taskCreation_padding"
                android:textSize="@dimen/taskCreation_textSize" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginTop="@dimen/layout_marginTop"
                android:gravity="center"
                android:text="Task description"
                android:textColor="#000"
                android:textSize="@dimen/taskCreation_textSize"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/taskDes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/rounded_edittext"
                android:gravity="bottom"
                android:hint="What neds to be done?"
                android:padding="@dimen/taskCreation_padding"
                android:textSize="@dimen/taskCreation_textSize" />


            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginTop="@dimen/layout_marginTop"
                android:gravity="center"
                android:text="Who Should Do This?"
                android:textColor="#000"
                android:textSize="@dimen/taskCreation_textSize"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/spinner_border"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/TaskUsers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:padding="5dp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:padding="5sp"
                    android:src="@drawable/drop_down" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/taskCreation_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="From Date and From Time"
                    android:textSize="@dimen/taskCreation_textSize"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/fromDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="3"
                        android:gravity="left"
                        android:text="From Date"
                        android:textColor="#000"
                        android:textSize="@dimen/Date_textsize"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/fromDateImage"
                        android:layout_width="0dp"
                        android:padding="@dimen/taskCreation_padding"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="2"
                        android:background="@color/white"
                        android:src="@drawable/calender" />

                    <TextView
                        android:id="@+id/fromTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="2"
                        android:gravity="left"
                        android:text="fromTime"
                        android:textColor="#000"
                        android:textSize="@dimen/Date_textsize"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/fromTimeImage"
                        android:layout_width="0dp"
                        android:padding="@dimen/taskCreation_padding"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="2"
                        android:background="@color/white"
                        android:onClick="onButtonClicked"
                        android:src="@drawable/time" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="To Date and To Time"
                    android:textSize="@dimen/taskCreation_textSize"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="left"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/toDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1.5"
                        android:gravity="left"
                        android:text="To Date"
                        android:textColor="#000"
                        android:textSize="@dimen/Date_textsize"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/toDateImage"
                        android:layout_width="0dp"
                        android:padding="@dimen/taskCreation_padding"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:background="@color/white"
                        android:src="@drawable/calender" />


                    <TextView
                        android:id="@+id/toTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="left"
                        android:text="toTime"
                        android:textColor="#000"
                        android:textSize="@dimen/Date_textsize"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/toTimeImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:padding="@dimen/taskCreation_padding"
                        android:background="@color/white"
                        android:src="@drawable/time" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>



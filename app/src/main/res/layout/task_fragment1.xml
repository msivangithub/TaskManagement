<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    android:orientation="vertical"
    android:padding="@dimen/taskCreation_padding">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:gravity="center"
                android:text="Task Heading"
                android:textColor="#000"
                android:textSize="@dimen/taskCreation_textSize"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/taskHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:background="@drawable/rounded_edittext"
                android:gravity="bottom"
                android:hint="Select type of task?"
                android:padding="@dimen/taskCreation_padding"
                android:textSize="@dimen/taskCreation_textSize" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/layout_marginTop">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:gravity="center"
                    android:text="Task description"
                    android:textColor="#000"
                    android:textSize="@dimen/taskCreation_textSize"
                    android:textStyle="bold" />


            </LinearLayout>

            <EditText
                android:id="@+id/taskDes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/rounded_edittext"
                android:gravity="bottom"
                android:hint="What neds to be done?"
                android:padding="@dimen/taskCreation_padding"
                android:textSize="@dimen/taskCreation_textSize" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginTop="@dimen/layout_marginTop"
                android:gravity="center"
                android:text="Who Should Do This?"
                android:textColor="#000"
                android:textSize="@dimen/taskCreation_textSize"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/spinner_border"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/TaskUsers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:padding="5dp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:padding="5sp"
                    android:src="@drawable/drop_down" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/taskCreation_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="From Date and From Time"
                    android:textSize="@dimen/taskCreation_textSize" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_edittext"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <TextView
                        android:id="@+id/fromDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="3"
                        android:gravity="left"
                        android:text="From Date"
                        android:textColor="#8c8a8a"
                        android:textSize="@dimen/Date_textsize"
                        android:textStyle="bold" />

                    <ImageButton

                        android:id="@+id/fromDateImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="2"
                        android:background="@color/white"
                        android:padding="@dimen/taskCreation_padding"
                        android:src="@drawable/calender" />

                    <TextView
                        android:id="@+id/fromTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="2"
                        android:gravity="left"
                        android:text="fromTime"
                        android:textColor="#8c8a8a"
                        android:textSize="@dimen/Date_textsize"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/fromTimeImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="2"
                        android:background="@color/white"
                        android:onClick="onButtonClicked"
                        android:padding="@dimen/taskCreation_padding"
                        android:src="@drawable/time" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="To Date and To Time"
                    android:textSize="@dimen/taskCreation_textSize" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_edittext"
                    android:gravity="left"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <TextView
                        android:id="@+id/toDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1.5"
                        android:gravity="left"
                        android:text="To Date"
                        android:textColor="#8c8a8a"
                        android:textSize="@dimen/Date_textsize"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/toDateImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:background="@color/white"
                        android:padding="@dimen/taskCreation_padding"
                        android:src="@drawable/calender" />


                    <TextView
                        android:id="@+id/toTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="left"
                        android:text="toTime"
                        android:textColor="#8c8a8a"
                        android:textSize="@dimen/Date_textsize"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/toTimeImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:background="@color/white"
                        android:padding="@dimen/taskCreation_padding"
                        android:src="@drawable/time" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:text="Choose the priority of this task"
                android:textColor="#000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/none"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="None "
                        android:textColor="@color/grey_800"
                        android:textSize="@dimen/taskCreation_radiobutton_textSize"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/low"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Low "
                        android:textColor="@color/green_800"
                        android:textSize="@dimen/taskCreation_radiobutton_textSize"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medium "
                        android:textColor="@color/blue_900"
                        android:textSize="@dimen/taskCreation_radiobutton_textSize"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/High"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High "
                        android:textColor="@color/red_900"
                        android:textSize="@dimen/taskCreation_radiobutton_textSize"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/veryHigh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Very High"
                        android:textColor="@color/red_900"
                        android:textSize="@dimen/taskCreation_radiobutton_textSize"
                        android:textStyle="bold"
                        android:visibility="gone" />


                </RadioGroup>
            </LinearLayout>


            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/spinner_border"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:padding="5sp"
                    android:src="@drawable/drop_down" />

                <Spinner
                    android:id="@+id/repeat_task"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:entries="@array/repeat"
                    android:gravity="center"
                    android:padding="5dp" />

            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/record"
                    style="@style/Widget.AppCompat.Button.Colored"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Media" />

                <TextView
                    android:id="@+id/add"
                    style="@style/Widget.AppCompat.Button.Colored"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add" />
            </LinearLayout>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/recyclerview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:visibility="gone"
                tools:context="com.office.taskmanager.fragmentssss" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/SelectedImage"
                    android:layout_width="150dp"
                    android:layout_height="120dp"
                    android:src="@drawable/profile_sample"
                    android:visibility="gone" />

                <VideoView
                    android:id="@+id/videoPreview"
                    android:layout_width="500dp"
                    android:layout_height="200dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>


    </ScrollView>


</LinearLayout>



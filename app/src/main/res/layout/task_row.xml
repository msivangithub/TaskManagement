        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal">

                <ImageView xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/icon_entry"
                    android:layout_gravity="center"
                    android:layout_width="@dimen/image_layout_width"
                    android:layout_height="@dimen/image_layout_height"
                    android:src="@android:drawable/ic_menu_gallery"
                    />
                <!-- <TextView
                     android:id="@+id/icon_entry"
                     android:layout_width="@dimen/taskRow_layout_width"
                     android:layout_height="@dimen/taskRow_layout_height"
                     android:layout_margin="@dimen/taskRow_layout_margin"
                     android:background="@drawable/circular_textview"
                     android:fontFamily="sans-serif-thin"
                     android:gravity="center"
                     android:text="TM"
                     android:textAllCaps="true"
                     android:textColor="#FFF"
                     android:textSize="@dimen/taskRow_textSize" />-->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="7"
                    android:padding="3dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/taskrow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_taskheader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:text="Task heading "
                            android:textColor="@color/pink_900"
                            android:textSize="@dimen/taskRow_header_textSize"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/taskTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:text="Task Description"
                            android:textSize="@dimen/taskRow_header_textSize" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/taskDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="left"
                                android:text="Date"
                                android:textSize="@dimen/taskRow_header_textSize" />


                            <TextView
                                android:id="@+id/taskTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="left|top"
                                android:text="Time"
                                android:textSize="@dimen/taskRow_header_textSize" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/deleteTask"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_weight="1.6"
                    android:clickable="true"
                    android:gravity="center"
                    android:orientation="vertical">



                    <ImageButton
                        android:id="@+id/Button_menu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="right"
                        android:background="@drawable/btn_feed_action"
                        android:src="@drawable/ic_more_grey_48" />
                    <TextView
                        android:id="@+id/asignBy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:singleLine="true"
                        android:text="name"
                        android:textColor="@color/pink_900"
                        android:textSize="@dimen/taskRow_header_textSize" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="15dp"
        android:background="#dfdddd" />
  <!--  </android.support.v7.widget.CardView>-->


</LinearLayout>
